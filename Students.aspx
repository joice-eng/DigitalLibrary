<%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="Students.aspx.cs"
    Inherits="DigitalLibrary.Students" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Student Management</title>
    <style>
        body {
            font-family: Arial;
            margin: 40px;
            background-color: #f4f6f9;
        }

        .container {
            max-width: 750px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 8px;
        }

        .field {
            margin-bottom: 15px;
        }

        .field label {
            display: block;
            margin-bottom: 6px;
        }

        .field input {
            width: 95%;
            padding: 10px;
        }

        .btn {
            background: #0879d1;
            color: white;
            padding: 12px 25px;
            border: none;
            cursor: pointer;
        }

        .message {
            display: block;
            margin: 15px 0;
        }

        .grid {
            margin-top: 20px;
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">
        <div class="container">

            <h2>Student Management</h2>

            <div class="field">
                <label>Student Name</label>
                <asp:TextBox ID="txtStudentName"
                    runat="server"></asp:TextBox>
            </div>

            <div class="field">
                <label>Department</label>
                <asp:TextBox ID="txtDepartment"
                    runat="server"></asp:TextBox>
            </div>

            <div class="field">
                <label>Age</label>
                <asp:TextBox ID="txtAge"
                    runat="server"
                    TextMode="Number"></asp:TextBox>
            </div>

            <asp:Button ID="btnAddStudent"
                runat="server"
                Text="Add Student"
                CssClass="btn"
                OnClick="btnAddStudent_Click" />

            <asp:Label ID="lblMessage"
                runat="server"
                CssClass="message"></asp:Label>

            <h3>Student List</h3>

           <asp:GridView ID="gvStudents"
                 runat="server"
                AutoGenerateColumns="true"
               DataKeyNames="StudentID"
               OnRowEditing="gvStudents_RowEditing"
               OnRowCancelingEdit="gvStudents_RowCancelingEdit"
               OnRowUpdating="gvStudents_RowUpdating"
               OnRowDeleting="gvStudents_RowDeleting"
                CssClass="grid"
                CellPadding="8"
                EmptyDataText="No students found."
                AutoGenerateEditButton="true"
                AutoGenerateDeleteButton="true">
          </asp:GridView>

            <br />
            <a href="Default.aspx">Back to Home</a>

        </div>
    </form>
</body>
</html>